# Copy this file to .env and fill in real values
# NEVER commit your real .env to git

# Required - generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Database - leave blank to use local SQLite (good for development)
DATABASE_URL=

# SQL Server (only if not using DATABASE_URL)
SQLSERVER_HOST=localhost
SQLSERVER_DB=HumanResource
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server

# Set to 0 to force SQL Server
USE_SQLITE_FALLBACK=1

# Frontend origin for CORS
FRONTEND_URL=http://localhost:3000
